        vint16m1_t mag_16 = __riscv_vle16_v_i16m1(read_ptr, vl);

        // Scale by 255
        // Intrinsic: Vector Multiply by Scalar. 
        vint16m1_t scaled_16 = __riscv_vmul_vx_i16m1(mag_16, 255, vl);

        // Divide by global_max
        // Intrinsic: Vector Divide by Scalar. 
        vint16m1_t norm_16 = __riscv_vdiv_vx_i16m1(scaled_16, global_max, vl);
